<%- include('partials/header') %>

<section class="hero">
  <h1>Lost something? Found something?</h1>
  <p>Report it here, or browse items other people have posted.</p>
  <a class="btn" href="/items">Browse items</a>
  <a class="btn" href="/report">Report an item</a>
</section>

<h2>Latest reports</h2>
<% if (latest.length === 0) { %>
  <p>No items reported yet.</p>
<% } else { %>
  <div class="item-grid">
    <% latest.forEach(function (it) { %>
      <article class="item-card">
        <span class="badge badge-<%= it.type %>"><%= it.type %></span>
        <span class="badge badge-status-<%= it.status %>"><%= it.status %></span>
        <h3><a href="/items/<%= it.item_id %>"><%= it.title %></a></h3>
        <p class="meta"><%= it.category %> &middot; <%= it.location %> &middot; <%= new Date(it.date_reported).toLocaleDateString('en-GB') %></p>
      </article>
    <% }); %>
  </div>
<% } %>

<%- include('partials/footer') %>
