<%- include('partials/header') %>

<section class="page-heading">
  <p class="eyebrow">Join the community</p>
  <h1>Create an account</h1>
  <p>Sign up to report an item and follow up on claims.</p>
</section>

<% if (errors.length) { %>
  <div class="errors" role="alert">
    <% errors.forEach(function (msg) { %><p><%= msg %></p><% }); %>
  </div>
<% } %>

<form class="form-box" method="post" action="/register">
  <label for="name">Name</label>
  <input type="text" id="name" name="name" autocomplete="name" value="<%= form.name || '' %>" required>

  <label for="email">Email</label>
  <input type="email" id="email" name="email" autocomplete="email" value="<%= form.email || '' %>" required>

  <label for="phone">Phone (optional)</label>
  <input type="text" id="phone" name="phone" autocomplete="tel" value="<%= form.phone || '' %>">

  <label for="password">Password</label>
  <input type="password" id="password" name="password" minlength="8" autocomplete="new-password" required>

  <label for="confirm">Confirm password</label>
  <input type="password" id="confirm" name="confirm" minlength="8" autocomplete="new-password" required>

  <button type="submit">Create account</button>
  <p class="form-help">Already registered? <a href="/login">Log in</a>.</p>
</form>

<%- include('partials/footer') %>