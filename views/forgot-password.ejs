<%- include('partials/header') %>

<section class="page-heading">
  <p class="eyebrow">Account recovery</p>
  <h1>Forgot password?</h1>
  <p>Enter the email you used to create your account.</p>
</section>

<% if (errors.length) { %>
  <div class="errors" role="alert"><% errors.forEach(function (error) { %><p><%= error %></p><% }); %></div>
<% } %>
<% if (sent) { %>
  <p class="claim-notice" role="status">If this email is registered, a recovery message has been prepared. Use the latest link within 15 minutes.</p>
<% } %>

<form class="form-box" method="post" action="/forgot-password">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <label for="email">Registered email</label>
  <input type="email" id="email" name="email" maxlength="100" autocomplete="email" required>
  <button type="submit">Request reset link</button>
  <% if (localRecovery) { %>
    <p class="form-help">Local version: recovery messages are saved privately on the host laptop. They are not emailed yet.</p>
  <% } %>
  <p class="form-help"><a href="/login">Back to log in</a></p>
</form>

<%- include('partials/footer') %>
