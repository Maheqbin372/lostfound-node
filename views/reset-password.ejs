<%- include('partials/header') %>

<section class="page-heading">
  <p class="eyebrow">Account recovery</p>
  <h1>Choose a new password</h1>
  <p>Use a password with at least 8 characters.</p>
</section>

<% if (errors.length) { %>
  <div class="errors" role="alert"><% errors.forEach(function (error) { %><p><%= error %></p><% }); %></div>
<% } %>
<% if (!valid) { %>
  <div class="form-box">
    <p>This recovery link is invalid, expired or already used.</p>
    <p class="form-help"><a href="/forgot-password">Request a new link</a></p>
  </div>
<% } else { %>
  <form class="form-box" method="post" action="/reset-password">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <input type="hidden" name="token" value="<%= token %>">
    <label for="password">New password</label>
    <input type="password" id="password" name="password" minlength="8" maxlength="72" autocomplete="new-password" required>
    <label for="confirm">Confirm new password</label>
    <input type="password" id="confirm" name="confirm" minlength="8" maxlength="72" autocomplete="new-password" required>
    <button type="submit">Reset password</button>
    <p class="form-help"><a href="/login">Back to log in</a></p>
  </form>
<% } %>

<%- include('partials/footer') %>
